<Window x:Class="CoreVigil.UI.VigilUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreVigil" Width="410" Height="445"
        WindowStartupLocation="Manual" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnPersistedStateLoaded"
        LocationChanged="OnPersistedLocationChanged"
        IsVisibleChanged="OnPersistedVisibilityChanged">

    <Window.Resources>
        <!-- Barra de telemetria personalizada de CoreVigil. -->
        <Style x:Key="CoreVigilCpuProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#182331" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="8" ClipToBounds="True">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="#30445D" BorderThickness="1" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#356DFF" Offset="0" />
                                        <GradientStop Color="#39C8FF" Offset="0.72" />
                                        <GradientStop Color="#A8F3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4C8DFF" BlurRadius="7" ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="4" BorderBrush="#55739B" BorderThickness="1" Opacity="0.35" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoreVigilModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#617083" />
            <Setter Property="BorderBrush" Value="#29415E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#183657" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4C8DFF" />
                                <Setter Property="Foreground" Value="#9FD5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#204B78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#102A43" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#35699C" />
                                <Setter Property="Foreground" Value="#6FA8FF" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoreVigilExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#AEB8C8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Padding="0"
                                          Focusable="False" HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="›" Width="8" Margin="0,0,2,0" Foreground="#587CA8" FontSize="10" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoreVigilScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>
    </Window.Resources>

    <Grid x:Name="HudRoot" Margin="14">
        <Border x:Name="HudPanel" Width="404" Height="438" CornerRadius="16" BorderThickness="1" BorderBrush="#334C8DFF" Padding="18">
            <Border.Background>
                <SolidColorBrush Color="#10131A" Opacity="0.82" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="26"
                            Height="22"
                            Margin="0,0,3,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6FA8FF"
                            FontSize="12"
                            Content="▭"
                            ToolTip="Modo Mini"
                            Click="OnMiniModeButtonClick" />
                    <Button x:Name="TopmostButton" Width="26" Height="22" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Foreground="#7F8999" FontSize="14" Content="○" ToolTip="Mantener siempre visible" Click="OnTopmostButtonClick" />
                    <Button Width="26" Height="22" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Foreground="#7F8999" FontSize="15" Content="−" ToolTip="Minimizar" Click="OnMinimizeButtonClick" />
                    <Button Width="26" Height="22" Background="Transparent" BorderThickness="0" Foreground="#7F8999" FontSize="15" Content="×" ToolTip="Ocultar" Click="OnCloseButtonClick" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,-8,82,0">
                    <TextBlock Text="COREVIGIL" Foreground="#6FA8FF" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProcessorName}" Margin="0,2,0,0" Foreground="#7F8999" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="#7F8999" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CpuUsageText}" Margin="0,-2,0,0" Foreground="White" FontSize="42" FontWeight="Light" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FRECUENCIA" Foreground="#7F8999" FontSize="10" HorizontalAlignment="Right" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CpuFrequencyText}" Foreground="#6FA8FF" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text=" / " Foreground="#7F8999" FontSize="12" />
                            <TextBlock Text="{Binding CpuMaximumFrequencyText}" Foreground="#AEB8C8" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ProgressBar Grid.Row="3" Value="{Binding CpuUsagePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,7,0,0" Style="{StaticResource CoreVigilCpuProgressBarStyle}" />
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SISTEMA" Foreground="#7F8999" FontSize="9" />
                        <TextBlock Text="{Binding SystemUptimeText}" Margin="0,2,0,0" Foreground="#AEB8C8" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="COREVIGIL" Foreground="#7F8999" FontSize="9" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ApplicationElapsedText}" Margin="0,2,0,0" Foreground="#AEB8C8" FontSize="13" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RAM" Foreground="#7F8999" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" Margin="10,0,12,0" Foreground="#AEB8C8" FontSize="13" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="2"
                                     Value="{Binding MemorySnapshot.UsagePercent, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="5" Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource CoreVigilCpuProgressBarStyle}" />
                    <TextBlock Grid.Column="3" Text="{Binding MemoryUsagePercentText}" Foreground="#6FA8FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="6" Height="1" Margin="0,10,0,8" Background="#263445" />

                <!-- Actividad CPU retractil con vistas agrupada e individual -->
                <Expander Grid.Row="7" x:Name="CpuActivityExpander" IsExpanded="True" Expanded="OnCpuActivityExpanded" Collapsed="OnCpuActivityCollapsed" Margin="0" Foreground="#AEB8C8" Style="{StaticResource CoreVigilExpanderStyle}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVIDAD CPU" Foreground="#7F8999"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,0,6,0">
                                <Button x:Name="GroupedProcessViewButton" Content="AGRUPAR" Margin="0,0,2,0"
                                            Style="{StaticResource CoreVigilModeButtonStyle}" IsEnabled="False"
                                            Click="OnGroupedProcessViewClick" />
                                <Button x:Name="IndividualProcessViewButton" Content="INDIVIDUAL"
                                            Style="{StaticResource CoreVigilModeButtonStyle}"
                                            Click="OnIndividualProcessViewClick" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="TOP 8" Foreground="#4C8DFF"
                                           FontSize="9" VerticalAlignment="Center" />
                        </Grid>
                    </Expander.Header>
                    <ScrollViewer Margin="0,5,0,0" MaxHeight="135" Style="{StaticResource CoreVigilScrollViewerStyle}">
                        <StackPanel>

                            <ItemsControl x:Name="GroupedProcessView" ItemsSource="{Binding ProcessGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,1,0,1" Foreground="#AEB8C8" Style="{StaticResource CoreVigilExpanderStyle}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="#AEB8C8" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="5,0,0,0" Foreground="#617083" FontSize="9"><Run Text="(" /><Run Text="{Binding InstanceCount}" /><Run Text=")" /></TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="#6FA8FF" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}}" /><Run Text=" %" /></TextBlock>
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Processes}" Margin="16,2,0,3">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Foreground="#7F8999" FontSize="9"><Run Text="PID " /><Run Text="{Binding ProcessId}" /></TextBlock>
                                                            <TextBlock Grid.Column="1" Foreground="#698FC7" FontSize="9"><Run Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}}" /><Run Text=" %" /></TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="IndividualProcessView" ItemsSource="{Binding TopProcesses}" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#AEB8C8" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="#6FA8FF" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}}" /><Run Text=" %" /></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <TextBlock Grid.Row="8" Text="{Binding StatusText}" Margin="0,9,0,0" Foreground="#617083" FontSize="9" HorizontalAlignment="Center" />
                <Border Grid.Row="9" Width="42" Height="2" Margin="0,6,0,0" CornerRadius="1" Background="#4C8DFF" Opacity="0.55" HorizontalAlignment="Center" />
            </Grid>
        </Border>
        <!-- Modo Mini de CoreVigil.
             Reutiliza el mismo DataContext del HUD principal. -->
        <Border x:Name="MiniHudPanel"
                Width="230"
                Height="42"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="21"
                BorderThickness="1"
                BorderBrush="#334C8DFF"
                Padding="8,0">
            <Border.Background>
                <SolidColorBrush Color="#10131A"
                                 Opacity="0.90" />
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>

                <!-- Indicador CoreVigil -->
                <Border Grid.Column="0"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        Background="#173B6D"
                        BorderBrush="#4C8DFF"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                    <Ellipse x:Name="MiniStatusLed"
                             Width="7"
                             Height="7"
                             Fill="#4C8DFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="MiniStatusLedGlow"
                          Color="#4C8DFF"
                          BlurRadius="8"
                          ShadowDepth="0"
                          Opacity="0.85" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Border>

                <!-- Telemetria Mini -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="RAM:"
                               Foreground="#7F8999"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding MemoryUsagePercentText}"
                               Margin="4,0,10,0"
                               Foreground="#AEB8C8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <TextBlock Text="CPU:"
                               Foreground="#7F8999"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding CpuUsageText}"
                               Margin="4,0,0,0"
                               Foreground="#6FA8FF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Control para regresar al HUD completo.
                     Se conectara en el siguiente paso. -->
                <Button Grid.Column="2"
        Width="22"
        Height="22"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        ToolTip="Restaurar HUD completo"
        Click="OnRestoreFullHudClick">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MiniRestoreBorder"
                    Width="20"
                    Height="20"
                    CornerRadius="10"
                    Background="#173B6D"
                    BorderBrush="#4C8DFF"
                    BorderThickness="1">

                                <TextBlock Text="↗"
                           Foreground="#6FA8FF"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                         Value="True">
                                    <Setter TargetName="MiniRestoreBorder"
                            Property="Background"
                            Value="#204B78" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
