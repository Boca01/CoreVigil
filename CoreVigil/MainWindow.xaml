<Window x:Class="CoreVigil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreVigil" Width="410" Height="445"
        WindowStartupLocation="Manual" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Barra de telemetria personalizada de CoreVigil. -->
        <Style x:Key="CoreVigilCpuProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#182331" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="8" ClipToBounds="True">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                    BorderBrush="#30445D" BorderThickness="1" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#356DFF" Offset="0" />
                                        <GradientStop Color="#39C8FF" Offset="0.72" />
                                        <GradientStop Color="#A8F3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4C8DFF" BlurRadius="7"
                                                      ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="4" BorderBrush="#55739B"
                                    BorderThickness="1" Opacity="0.35" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="HudRoot" Margin="14">
        <Viewbox x:Name="HudViewbox" Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="HudPanel" Width="404" Height="438" CornerRadius="16"
                    BorderThickness="1" BorderBrush="#334C8DFF" Padding="18">
                <Border.Background>
                    <SolidColorBrush Color="#10131A" Opacity="0.82" />
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Controles del HUD -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="TopmostButton" Width="26" Height="22" Margin="0,0,3,0"
                                Background="Transparent" BorderThickness="0" Foreground="#7F8999"
                                FontSize="14" Content="○" ToolTip="Mantener siempre visible"
                                Click="OnTopmostButtonClick" />
                        <Button Width="26" Height="22" Margin="0,0,3,0" Background="Transparent"
                                BorderThickness="0" Foreground="#7F8999" FontSize="15" Content="−"
                                ToolTip="Minimizar" Click="OnMinimizeButtonClick" />
                        <Button Width="26" Height="22" Background="Transparent" BorderThickness="0"
                                Foreground="#7F8999" FontSize="15" Content="×" ToolTip="Ocultar"
                                Click="OnCloseButtonClick" />
                    </StackPanel>

                    <!-- Identidad -->
                    <StackPanel Grid.Row="1" Margin="0,-8,82,0">
                        <TextBlock Text="COREVIGIL" Foreground="#6FA8FF" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProcessorName}" Margin="0,2,0,0" Foreground="#7F8999"
                                   FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="290" />
                    </StackPanel>

                    <!-- CPU principal -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="#7F8999" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CpuUsageText}" Margin="0,-2,0,0" Foreground="White"
                                       FontSize="42" FontWeight="Light" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FRECUENCIA" Foreground="#7F8999" FontSize="10" HorizontalAlignment="Right" />
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CpuFrequencyText}" Foreground="#6FA8FF" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text=" / " Foreground="#7F8999" FontSize="12" />
                                <TextBlock Text="{Binding CpuMaximumFrequencyText}" Foreground="#AEB8C8" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Barra CPU personalizada -->
                    <ProgressBar Grid.Row="3" Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                 Minimum="0" Maximum="100" Height="8" Margin="0,7,0,0"
                                 Style="{StaticResource CoreVigilCpuProgressBarStyle}" />

                    <!-- Tiempos -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SISTEMA" Foreground="#7F8999" FontSize="9" />
                            <TextBlock Text="{Binding SystemUptimeText}" Margin="0,2,0,0" Foreground="#AEB8C8" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="COREVIGIL" Foreground="#7F8999" FontSize="9" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ApplicationElapsedText}" Margin="0,2,0,0" Foreground="#AEB8C8"
                                       FontSize="13" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- RAM -->
                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RAM" Foreground="#7F8999" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}" Margin="10,0,0,0"
                                   Foreground="#AEB8C8" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryUsagePercentText}" Foreground="#6FA8FF"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="6" Height="1" Margin="0,10,0,8" Background="#263445" />

                    <!-- Actividad CPU retractil -->
                    <Expander Grid.Row="7" x:Name="CpuActivityExpander" IsExpanded="True"
                              Expanded="OnCpuActivityExpanded" Collapsed="OnCpuActivityCollapsed"
                              Margin="0" Foreground="#AEB8C8">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ACTIVIDAD CPU" Foreground="#7F8999"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TOP 8" Margin="12,0,0,0"
                                           Foreground="#4C8DFF" FontSize="9" VerticalAlignment="Center" />
                            </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding TopProcesses}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#AEB8C8"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="#6FA8FF"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <Run Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}}" /><Run Text=" %" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Grid.Row="8" Text="{Binding StatusText}" Margin="0,9,0,0"
                               Foreground="#617083" FontSize="9" HorizontalAlignment="Center" />
                    <Border Grid.Row="9" Width="42" Height="2" Margin="0,6,0,0" CornerRadius="1"
                            Background="#4C8DFF" Opacity="0.55" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
