<Window x:Class="CoreVigil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreVigil"
        Width="542"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">


    <Grid Margin="20">

        <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#334C8DFF"
            Padding="24">

            <Border.Background>
                <SolidColorBrush Color="#10131A"
                             Opacity="0.82" />
            </Border.Background>

            <StackPanel VerticalAlignment="Center">

                <Grid Margin="0,0,0,4">

                    <StackPanel HorizontalAlignment="Right"
                Orientation="Horizontal">

                        <Button Width="28"
                Height="24"
                Margin="0,0,4,0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#7F8999"
                FontSize="16"
                Content="−"
                ToolTip="Minimizar"
                Click="OnMinimizeButtonClick" />

                        <Button Width="28"
                Height="24"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#7F8999"
                FontSize="16"
                Content="×"
                ToolTip="Cerrar"
                Click="OnCloseButtonClick" />

                    </StackPanel>

                </Grid>

                <TextBlock Text="COREVIGIL"
                       Foreground="#6FA8FF"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding ProcessorName}"
                       Margin="0,6,0,0"
                       Foreground="#7F8999"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       MaxWidth="350" />

            <TextBlock Text="CPU"
                       Margin="0,20,0,0"
                       Foreground="#AEB8C8"
                       FontSize="18"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding CpuUsageText}"
                       Margin="0,4,0,0"
                       Foreground="White"
                       FontSize="54"
                       FontWeight="Light"
                       HorizontalAlignment="Center" />

            <StackPanel Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                <TextBlock Text="FRECUENCIA"
                           Foreground="#7F8999"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding CpuFrequencyText}"
                           Margin="10,0,0,0"
                           Foreground="#6FA8FF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock Text=" / "
                           Margin="4,0,4,0"
                           Foreground="#7F8999"
                           FontSize="16"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding CpuMaximumFrequencyText}"
                           Foreground="#AEB8C8"
                           FontSize="16"
                           VerticalAlignment="Center" />

            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                <TextBlock Text="UPTIME"
                           Foreground="#7F8999"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding SystemUptimeText}"
                           Margin="10,0,0,0"
                           Foreground="#AEB8C8"
                           FontSize="16"
                           VerticalAlignment="Center" />

            </StackPanel>

            <StackPanel Margin="0,6,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

                <TextBlock Text="COREVIGIL"
               Foreground="#7F8999"
               FontSize="12"
               VerticalAlignment="Center" />

                <TextBlock Text="{Binding ApplicationElapsedText}"
               Margin="10,0,0,0"
               Foreground="#AEB8C8"
               FontSize="16"
               VerticalAlignment="Center" />

            </StackPanel>

            <StackPanel Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

                <TextBlock Text="RAM"
               Foreground="#7F8999"
               FontSize="12"
               VerticalAlignment="Center" />

                <TextBlock Text="{Binding MemoryUsageText}"
               Margin="10,0,0,0"
               Foreground="#AEB8C8"
               FontSize="16"
               VerticalAlignment="Center" />

                <TextBlock Text="  /  "
               Foreground="#7F8999"
               FontSize="12"
               VerticalAlignment="Center" />

                <TextBlock Text="{Binding MemoryUsagePercentText}"
               Foreground="#6FA8FF"
               FontSize="16"
               FontWeight="SemiBold"
               VerticalAlignment="Center" />

            </StackPanel>

            <TextBlock Text="TOP CPU"
                       Margin="0,16,0,6"
                       Foreground="#7F8999"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <ItemsControl ItemsSource="{Binding TopProcesses}"
                          Margin="40,0,40,0">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="0,2,0,2">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Foreground="#AEB8C8"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Foreground="#6FA8FF"
                                       FontSize="12"
                                       FontWeight="SemiBold">

                                <Run Text="{Binding CpuUsagePercent,
                                                  Mode=OneWay,
                                                  StringFormat={}{0:F1}}" />
                                <Run Text=" %" />

                            </TextBlock>

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}"
                         Minimum="0"
                         Maximum="100"
                         Height="8"
                         Margin="20,16,20,0"
                         Foreground="#4C8DFF"
                         Background="#252B36" />

            <TextBlock Text="{Binding StatusText}"
                       Margin="0,18,0,0"
                       Foreground="#7F8999"
                       FontSize="12"
                       HorizontalAlignment="Center" />

                </StackPanel>

        </Border>

    </Grid>
</Window>