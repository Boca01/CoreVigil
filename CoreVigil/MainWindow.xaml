<Window x:Class="CoreVigil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreVigil"
        Width="410"
        Height="445"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="HudRoot"
          Margin="14">

        <Viewbox x:Name="HudViewbox"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">

            <Border x:Name="HudPanel"
                    Width="404"
                    Height="438"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#334C8DFF"
                    Padding="18">

                <Border.Background>
                    <SolidColorBrush Color="#10131A"
                                     Opacity="0.82" />
                </Border.Background>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Controles del HUD -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">

                        <Button x:Name="TopmostButton"
                                Width="26"
                                Height="22"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#7F8999"
                                FontSize="14"
                                Content="○"
                                ToolTip="Mantener siempre visible"
                                Click="OnTopmostButtonClick" />

                        <Button Width="26"
                                Height="22"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#7F8999"
                                FontSize="15"
                                Content="−"
                                ToolTip="Minimizar"
                                Click="OnMinimizeButtonClick" />

                        <Button Width="26"
                                Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#7F8999"
                                FontSize="15"
                                Content="×"
                                ToolTip="Ocultar"
                                Click="OnCloseButtonClick" />

                    </StackPanel>

                    <!-- Identidad -->
                    <StackPanel Grid.Row="1"
                                Margin="0,-8,82,0">

                        <TextBlock Text="COREVIGIL"
                                   Foreground="#6FA8FF"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{Binding ProcessorName}"
                                   Margin="0,2,0,0"
                                   Foreground="#7F8999"
                                   FontSize="9"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="290" />

                    </StackPanel>

                    <!-- CPU principal -->
                    <Grid Grid.Row="2"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="CPU"
                                       Foreground="#7F8999"
                                       FontSize="11"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="{Binding CpuUsageText}"
                                       Margin="0,-2,0,0"
                                       Foreground="White"
                                       FontSize="42"
                                       FontWeight="Light" />

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="FRECUENCIA"
                                       Foreground="#7F8999"
                                       FontSize="10"
                                       HorizontalAlignment="Right" />

                            <StackPanel Margin="0,2,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">

                                <TextBlock Text="{Binding CpuFrequencyText}"
                                           Foreground="#6FA8FF"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <TextBlock Text=" / "
                                           Foreground="#7F8999"
                                           FontSize="12" />

                                <TextBlock Text="{Binding CpuMaximumFrequencyText}"
                                           Foreground="#AEB8C8"
                                           FontSize="12" />

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <!-- Barra CPU -->
                    <ProgressBar Grid.Row="3"
                                 Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,6,0,0"
                                 Foreground="#4C8DFF"
                                 Background="#252B36" />

                    <!-- Tiempos -->
                    <Grid Grid.Row="4"
                          Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="SISTEMA"
                                       Foreground="#7F8999"
                                       FontSize="9" />

                            <TextBlock Text="{Binding SystemUptimeText}"
                                       Margin="0,2,0,0"
                                       Foreground="#AEB8C8"
                                       FontSize="13" />

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="COREVIGIL"
                                       Foreground="#7F8999"
                                       FontSize="9"
                                       HorizontalAlignment="Right" />

                            <TextBlock Text="{Binding ApplicationElapsedText}"
                                       Margin="0,2,0,0"
                                       Foreground="#AEB8C8"
                                       FontSize="13"
                                       HorizontalAlignment="Right" />

                        </StackPanel>

                    </Grid>

                    <!-- RAM -->
                    <Grid Grid.Row="5"
                          Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="RAM"
                                   Foreground="#7F8999"
                                   FontSize="10"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding MemoryUsageText}"
                                   Margin="10,0,0,0"
                                   Foreground="#AEB8C8"
                                   FontSize="13"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding MemoryUsagePercentText}"
                                   Foreground="#6FA8FF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                    </Grid>

                    <!-- Separador -->
                    <Border Grid.Row="6"
                            Height="1"
                            Margin="0,10,0,8"
                            Background="#263445" />

                    <!-- Top CPU -->
                    <Grid Grid.Row="7">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="TOP CPU"
                                   Foreground="#7F8999"
                                   FontSize="10"
                                   FontWeight="SemiBold" />

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding TopProcesses}"
                                      Margin="0,5,0,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="0,2,0,2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Foreground="#AEB8C8"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Foreground="#6FA8FF"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">

                                            <Run Text="{Binding CpuUsagePercent,
                                                              Mode=OneWay,
                                                              StringFormat={}{0:F1}}" />
                                            <Run Text=" %" />

                                        </TextBlock>

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                    <!-- Estado -->
                    <TextBlock Grid.Row="8"
                               Text="{Binding StatusText}"
                               Margin="0,9,0,0"
                               Foreground="#617083"
                               FontSize="9"
                               HorizontalAlignment="Center" />

                    <!-- Pie visual -->
                    <Border Grid.Row="9"
                            Width="42"
                            Height="2"
                            Margin="0,6,0,0"
                            CornerRadius="1"
                            Background="#4C8DFF"
                            Opacity="0.55"
                            HorizontalAlignment="Center" />

                </Grid>

            </Border>

        </Viewbox>

    </Grid>
</Window>