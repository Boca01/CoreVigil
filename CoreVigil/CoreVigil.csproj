<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>

	  <ApplicationIcon>Assets\Icons\App\CoreVigil_App_Corrected.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Icons\Tray\CoreVigil_Critical.ico" />
    <None Remove="Assets\Icons\Tray\CoreVigil_High.ico" />
    <None Remove="Assets\Icons\Tray\CoreVigil_Low.ico" />
    <None Remove="Assets\Icons\Tray\CoreVigil_Medium.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\Tray\CoreVigil_Critical.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Tray\CoreVigil_High.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Tray\CoreVigil_Low.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Tray\CoreVigil_Medium.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Docs\" />
    <Folder Include="Views\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.14" />
  </ItemGroup>

</Project>
